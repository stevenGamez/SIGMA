<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <connectionStrings>
    <!-- Si tu SQL Server tiene otro nombre, cambia solo "Data Source". -->
    <add name="SIGMA"
         connectionString="Data Source=localhost\SQLEXPRESS;Initial Catalog=SIGMA;Integrated Security=True;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>
